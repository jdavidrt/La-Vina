{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="field-container" style="display: none;">
  <div class="field">
    <input
      form="{{ product_form_id }}"
      id="input-10palabras"
      class="field__input"
      type="text"
      name="properties[Tu frase personalizada]"
    >
    <label class="field__label" for="input-10palabras">Escribe tu frase personalizada: (máximo 9 palabras)</label>
  </div>
  <p id="error-message" class="error-message" style="display: none;">Solo se permiten hasta 9 palabras</p>
  <p id="empty-message" class="empty-message" style="display: none;">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log('[10-words] Inicializando validador.DiezPalabras = false');
    validador.DiezPalabras = false;

    const inputField = document.querySelector("#input-10palabras");
    const errorMessage = document.getElementById("error-message");
    const emptyMessage = document.getElementById("empty-message");

    // BUSCAR INPUTS RADIO DINÁMICAMENTE POR VALOR
    // Esto es mucho más robusto que usar IDs autogenerados como "template--16560389324869__main-2-1"
    const conMarcacionOption = document.querySelector('input[type="radio"][value="Con Marcación"]');
    const sinMarcacionOption = document.querySelector('input[type="radio"][value="Sin Marcación"]');

    if (!conMarcacionOption || !sinMarcacionOption) {
        console.warn('[10-words] No se encontraron las opciones "Con Marcación" o "Sin Marcación". Verifica los valores de las variantes.');
        // Si no existen las opciones, quizás deberíamos asumir que NO se requiere validación o manejarlo de otra forma.
        // Por ahora, retornamos para evitar errores.
        return; 
    }

    console.log('[10-words] Elementos encontrados:', {
        inputField, 
        conMarcacionOption, 
        sinMarcacionOption
    });

    // Función para validar el texto
    function validarTexto() {
      const valor = inputField.value;
      const words = valor.trim().split(/\s+/).filter(word => word.length > 0);
      const wordCount = words.length;

      console.log(`[10-words] Validando texto: "${valor}" | Palabras: ${wordCount}`);

      if (wordCount === 0 || wordCount > 9) {
        validador.DiezPalabras = false;
        errorMessage.style.display = wordCount > 9 ? "block" : "none";
        emptyMessage.style.display = wordCount === 0 ? "flex" : "none";
        console.log(`[10-words] Validación FALLIDA. WordCount: ${wordCount}. validador.DiezPalabras = false`);
      } else {
        validador.DiezPalabras = true;
        errorMessage.style.display = "none";
        emptyMessage.style.display = "none";
        console.log(`[10-words] Validación EXITOSA. WordCount: ${wordCount}. validador.DiezPalabras = true`);
      }
      
      // Always use the central helper so we get a fresh button reference
      // and the correct sonTodosVerdaderos logic
      if (window.checkAndUpdateButton) {
          window.checkAndUpdateButton();
      } else {
          console.error('[10-words] window.checkAndUpdateButton no está definido!');
      }
    }

    // Función para mostrar/ocultar el campo personalizado
    function toggleCustomTextField() {
      const fieldContainer = document.querySelector(".field-container");
      
      if (conMarcacionOption.checked) {
        console.log('[10-words] Opción "Con Marcación" seleccionada. Mostrando campo.');
        fieldContainer.style.display = "block";
        validador.DiezPalabras = false; // Requiere validación inicialmente
        validarTexto(); // Valida al mostrar el campo (llama a checkAndUpdateButton internamente)
      } else if (sinMarcacionOption.checked) {
        console.log('[10-words] Opción "Sin Marcación" seleccionada. Ocultando campo.');
        fieldContainer.style.display = "none";
        validador.DiezPalabras = true; // No requiere validación
        errorMessage.style.display = "none";
        emptyMessage.style.display = "none";
        
        if (window.checkAndUpdateButton) {
            window.checkAndUpdateButton();
        }
      }
    }

    // Inicializa el comportamiento según la opción seleccionada
    toggleCustomTextField();

    // Escucha cambios en las opciones
    // Usamos 'change' en los inputs radio directos
    conMarcacionOption.addEventListener("change", toggleCustomTextField);
    sinMarcacionOption.addEventListener("change", toggleCustomTextField);

    // Valida el texto cuando el usuario escribe
    inputField.addEventListener("input", validarTexto);
  });
</script>

<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
