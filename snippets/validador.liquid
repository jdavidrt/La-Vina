<script>
    let validador = {}

    function sonTodosVerdaderos(objeto) {
      // Empty object should NOT pass validation (vacuous truth bug)
      const vals = Object.values(objeto);
      return vals.length > 0 && vals.every(valor => valor === true);
    }

    // Global helper — always freshly queries the button and enables/disables
    // based on current validador state. All snippets should call this instead
    // of directly manipulating addToCartButton.
    window.checkAndUpdateButton = function() {
      const btn = document.querySelector('[name="add"]');
      if (!btn) return;
      if (sonTodosVerdaderos(validador)) {
        btn.disabled = false;
        console.log('[validador] ✅ Button ENABLED — all validations passed');
      } else {
        btn.disabled = true;
      }
    };

    // Disable button immediately if it is already in the DOM (before DOMContentLoaded).
    // addToCartButton is kept as a global for backward compatibility with older snippets
    // that still reference it directly. Prefer calling window.checkAndUpdateButton() instead.
    const addToCartButton = document.querySelector('[name="add"]');
    if (addToCartButton) addToCartButton.disabled = true;

    // MutationObserver: re-check on every childList DOM change
    const observer = new MutationObserver((mutationsList) => {
      for (const mutation of mutationsList) {
        if (mutation.type === 'childList') {
          console.log('[validador] DOM changed. Estado:', JSON.stringify(validador), '| Todos verdaderos:', sonTodosVerdaderos(validador));
        }
        window.checkAndUpdateButton();
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });

    // Also re-check once DOM is fully ready (catches cases where no mutation fires)
    document.addEventListener("DOMContentLoaded", function () {
      window.checkAndUpdateButton();
    });

    // Evitar emojis
    document.addEventListener("DOMContentLoaded", function () {
      function eliminarEmojis(text) {
        return text.replace(/\p{Emoji}/gu, "");
      }

      function validarInputSinEmojis(event) {
        const input = event.target;
        const valorSinEmojis = eliminarEmojis(input.value);
        if (input.value !== valorSinEmojis) {
          input.value = valorSinEmojis;
        }
      }

      document.querySelectorAll("input[type='text'], textarea").forEach(input => {
        input.addEventListener("input", validarInputSinEmojis);
      });
    });
</script>
