{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    validador.DiezPalabras = false;
  })
  function sonTodosVerdaderos(objeto) {
    return Object.values(objeto).every(valor => valor === true);
  }
</script>
<div class="field-container" style="display: block;">
  <div class="field">
    <input
      form="{{ product_form_id }}"
      id="input-10palabras"
      class="field__input"
      type="text"
      name="properties[Tu frase personalizada]"
    >
    <label class="field__label" for="input-10palabras">Escribe tu frase personalizada: (máximo 9 palabras)</label>
  </div>
  <p id="error-message" class="error-message">Solo se permiten hasta 9 palabras</p>
  <p id="empty-message" class="empty-message">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log('[10-words-relicario] Inicializando validador.DiezPalabras = false');
    validador.DiezPalabras = false;

    const inputField = document.querySelector("#input-10palabras")
    const errorMessage = document.getElementById("error-message");
    const emptyMessage = document.getElementById("empty-message");
    
    // Búsqueda dinámica de opciones "Con marcación" y "Sin marcación"
    let conMarcacionOption = null;
    let sinMarcacionOption = null;

    const allRadios = document.querySelectorAll('input[type="radio"]');
    allRadios.forEach(radio => {
        const val = radio.value.toLowerCase();
        if (val.includes('con marcación') || val.includes('con marcacion')) conMarcacionOption = radio;
        if (val.includes('sin marcación') || val.includes('sin marcacion')) sinMarcacionOption = radio;
    });

    if (!conMarcacionOption || !sinMarcacionOption) {
        console.warn("[10-words-relicario] Fallback: buscando por IDs conocidos para opciones de marcación.");
        conMarcacionOption = document.getElementById("template--16560574136389__main-1-1");
        sinMarcacionOption = document.getElementById("template--16560574136389__main-1-0");
    }

    if (!conMarcacionOption || !sinMarcacionOption) {
        console.error("[10-words-relicario] ERROR: No se encontraron las opciones de marcación.");
        // Evitar bloqueo
        validador.DiezPalabras = true; 
        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
        return;
    }
    
    console.log('[10-words-relicario] Opciones encontradas:', { conMarcacionOption, sinMarcacionOption });

        // Función para validar el campo de texto
    function validarTexto() {
      const words = inputField.value.trim().split(/\s+/).filter(word => word.length > 0);
      const wordCount = words.length;

      console.log(`[10-words-relicario] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      // Verifica si el campo está vacío o no cumple las condiciones
      if (wordCount === 0 || wordCount > 9) { // Corregido a > 9 para ser consistente con "máximo 9 palabras" label
         validador.DiezPalabras = false;
        errorMessage.style.display = wordCount > 9 ? "block" : "none"; // Muestra u oculta error
        console.log(`[10-words-relicario] Validación FALLIDA. WordCount: ${wordCount}. DiezPalabras = false`);
      } else {
        validador.DiezPalabras = true;
        errorMessage.style.display = "none"; // Oculta mensaje de error
        console.log(`[10-words-relicario] Validación EXITOSA. WordCount: ${wordCount}. DiezPalabras = true`);
      }
      
      // Muestra el mensaje "Por favor ingresa la frase personalizada" si está vacío
      emptyMessage.style.display = wordCount === 0 ? "flex" : "none";

      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
    }

    // Función para mostrar/ocultar el campo de texto personalizado
    function toggleCustomTextField() {
      const isConMarcacionSelected = conMarcacionOption.checked;
      const container = document.querySelector('.field-container');
      
      if (container) container.style.display = isConMarcacionSelected ? 'block' : 'none'; // Changed flex to block to match other snippets structure if needed

      if (conMarcacionOption.checked) {
        console.log('[10-words-relicario] Con Marcación seleccionada');
        validador.DiezPalabras = false;
        validarTexto();
      } else if (sinMarcacionOption.checked) {
        console.log('[10-words-relicario] Sin Marcación seleccionada');
        validador.DiezPalabras = true; // Actualiza validador a true si "Sin marcación" está seleccionada
        errorMessage.style.display = "none";
        emptyMessage.style.display = "none";
        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    // Inicializa el campo según la opción predeterminada (Sin Marcación)
    toggleCustomTextField();

    // Escucha los cambios de selección en las opciones de marcación
    conMarcacionOption.addEventListener("change", toggleCustomTextField);
    sinMarcacionOption.addEventListener("change", toggleCustomTextField);

    // Muestra el mensaje de "Por favor ingresa la frase personalizada" desde el inicio
    // emptyMessage.style.display = "flex"; // Comentado pq toggleCustomTextField ya maneja esto, y si está oculto no debe mostrarse

    // Escucha el evento input y valida el texto cada vez que cambia
    inputField.addEventListener("input", validarTexto);
  });
</script>
<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
