{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    validador.DiezPalabras = false;
  });
</script>

<div class="field-container" style="display: none;">
  <div class="field">
    <input
      form="{{ product_form_id }}"
      id="input-10palabras"
      class="field__input"
      type="text"
      name="properties[Tu frase personalizada]"
    >
    <label class="field__label" for="input-10palabras">Escribe tu frase personalizada: (máximo 9 palabras)</label>
  </div>
  <p id="error-message" class="error-message" style="display: none;">Solo se permiten hasta 9 palabras</p>
  <p id="empty-message" class="empty-message" style="display: none;">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log('[10-words-relicario] Inicializando validador.DiezPalabras = false');
    validador.DiezPalabras = false;

    const inputField = document.querySelector("#input-10palabras");
    const errorMessage = document.getElementById("error-message");
    const emptyMessage = document.getElementById("empty-message");
    const fieldContainer = document.querySelector('.field-container');

    // Buscar opciones de grabado de frase por texto del label (robusto, case-insensitive)
    let conFraseOption = null;
    let sinFraseOption = null;

    document.querySelectorAll('input[type="radio"]').forEach(radio => {
      let label = document.querySelector(`label[for="${radio.id}"]`);
      if (!label) label = radio.closest('label');
      const textToCheck = (label ? label.textContent : radio.value).trim().toLowerCase();
      if (textToCheck.includes('con frase') || textToCheck.includes('con marcacion') || textToCheck.includes('con marcación')) {
        conFraseOption = radio;
      } else if (textToCheck.includes('sin frase') || textToCheck.includes('sin marcacion') || textToCheck.includes('sin marcación')) {
        sinFraseOption = radio;
      }
    });

    if (!conFraseOption || !sinFraseOption) {
      console.warn("[10-words-relicario] Fallback: buscando por IDs conocidos.");
      conFraseOption = conFraseOption || document.getElementById("template--16560574136389__main-1-1");
      sinFraseOption = sinFraseOption || document.getElementById("template--16560574136389__main-1-0");
    }

    if (!conFraseOption || !sinFraseOption) {
      console.error("[10-words-relicario] ERROR: No se encontraron las opciones de marcación. Aprobando validación para no bloquear compra.");
      validador.DiezPalabras = true;
      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      return;
    }

    console.log('[10-words-relicario] Opciones encontradas:', { conFraseOption, sinFraseOption });

    function validarTexto() {
      if (!inputField) return;
      const words = inputField.value.trim().split(/\s+/).filter(w => w.length > 0);
      const wordCount = words.length;

      console.log(`[10-words-relicario] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      if (wordCount === 0 || wordCount > 9) {
        validador.DiezPalabras = false;
        if (errorMessage) errorMessage.style.display = wordCount > 9 ? "block" : "none";
        if (emptyMessage) emptyMessage.style.display = wordCount === 0 ? "flex" : "none";
        console.log(`[10-words-relicario] Validación FALLIDA. WordCount: ${wordCount}. DiezPalabras = false`);
      } else {
        validador.DiezPalabras = true;
        if (errorMessage) errorMessage.style.display = "none";
        if (emptyMessage) emptyMessage.style.display = "none";
        console.log(`[10-words-relicario] Validación EXITOSA. WordCount: ${wordCount}. DiezPalabras = true`);
      }

      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
    }

    function toggleCustomTextField() {
      if (conFraseOption.checked) {
        console.log('[10-words-relicario] Con Marcación seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'flex';
        validador.DiezPalabras = false;
        validarTexto();
      } else if (sinFraseOption.checked) {
        console.log('[10-words-relicario] Sin Marcación seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'none';
        validador.DiezPalabras = true;
        if (inputField) inputField.value = '';
        if (errorMessage) errorMessage.style.display = 'none';
        if (emptyMessage) emptyMessage.style.display = 'none';

        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    toggleCustomTextField();

    conFraseOption.addEventListener("change", toggleCustomTextField);
    sinFraseOption.addEventListener("change", toggleCustomTextField);

    if (inputField) inputField.addEventListener("input", validarTexto);
  });
</script>

<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
