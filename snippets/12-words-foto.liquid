{%- assign product_form_id = 'product-form-' | append: section.id -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    validador.DocePalabras = false;

    const inputField = document.querySelector('#nombre-input-2');
    const errorMessage = document.getElementById('error-message');
    const emptyMessage = document.getElementById('empty-message');

    // Robust selector logic for radio buttons
    let conMarcacionOption = null;
    let sinMarcacionOption = null;

    const allRadios = document.querySelectorAll('input[type="radio"]');
    allRadios.forEach(radio => {
        const val = radio.value.toLowerCase();
        if (val.includes('con marcación') || val.includes('con marcacion')) conMarcacionOption = radio;
        if (val.includes('sin marcación') || val.includes('sin marcacion')) sinMarcacionOption = radio;
    });

    // Fallback to IDs if not found by value
    if (!conMarcacionOption || !sinMarcacionOption) {
      conMarcacionOption = conMarcacionOption || document.getElementById('template--16597763031109__main-1-1');
      sinMarcacionOption = sinMarcacionOption || document.getElementById('template--16597763031109__main-1-0');
    }

    console.log('[12-words-foto] Options found:', {conMarcacionOption, sinMarcacionOption});

    // Function to show/hide the custom text field
    function toggleCustomTextField() {
      // Safety check
      if(!conMarcacionOption || !sinMarcacionOption) return;

      const container = document.querySelector('.field-container');
      
      if (conMarcacionOption.checked) {
        if(container) container.style.display = 'flex';
        validador.DocePalabras = false;
        validarTexto();
      } else if (sinMarcacionOption.checked) {
        if(container) container.style.display = 'none';
        validador.DocePalabras = true; 
        if(errorMessage) errorMessage.style.display = "none";
        if(emptyMessage) emptyMessage.style.display = "none";

        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    // Initialize field according to default option
    toggleCustomTextField();

    // Listen for changes in marking options
    if(conMarcacionOption) conMarcacionOption.addEventListener('change', toggleCustomTextField);
    if(sinMarcacionOption) sinMarcacionOption.addEventListener('change', toggleCustomTextField);

    // Function to validate text field
    function validarTexto() {
      // Safety check
      if(!inputField) return;

      const words = inputField.value.trim().split(/\s+/).filter((word) => word.length > 0);
      const wordCount = words.length;
      
      console.log(`[12-words-foto] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      // Check if field is empty or doesn't meet conditions
      if (wordCount === 0 || wordCount > 12) {
        validador.DocePalabras = false;
        if(errorMessage) errorMessage.style.display = wordCount > 12 ? 'block' : 'none';
        if(emptyMessage) emptyMessage.style.display = wordCount === 0 ? 'flex' : 'none';
        console.log(`[12-words-foto] FAIL. Words: ${wordCount}`);
      } else {
        validador.DocePalabras = true; 
        if(errorMessage) errorMessage.style.display = 'none';
        if(emptyMessage) emptyMessage.style.display = 'none';
        console.log(`[12-words-foto] PASS. Words: ${wordCount}`);
      }

      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
    }

    // Listen to input event and validate text each time it changes
    if(inputField) {
        inputField.addEventListener('input', validarTexto);
    }
  });
</script>

<div class="field-container">
  <!-- Custom text input field with style and label -->
  <div class="field">
    <input
      class="field__input"
      type="text"
      form="{{ product_form_id }}"
      name="properties[Tu frase personalizada]"
      id="nombre-input-2"
      required
    >
    <label class="field__label" for="nombre-input-2">Escribe tu frase personalizada: (máximo 11 palabras)</label>
  </div>
  <p id="error-message" class="error-message">Solo se permiten hasta 11 palabras</p>
  <p id="empty-message" class="empty-message">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>

<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: #961212;
    margin-right: 5px;
  }
</style>