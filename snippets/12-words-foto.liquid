{%- assign product_form_id = 'product-form-' | append: section.id -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    validador.DocePalabras = false;
  });
</script>

<div class="field-container" style="display: none;">
  <div class="field">
    <input
      class="field__input"
      type="text"
      form="{{ product_form_id }}"
      name="properties[Tu frase personalizada]"
      id="nombre-input-2"
    >
    <label class="field__label" for="nombre-input-2">Escribe tu frase personalizada: (máximo 11 palabras)</label>
  </div>
  <p id="error-message" class="error-message" style="display: none;">Solo se permiten hasta 11 palabras</p>
  <p id="empty-message" class="empty-message" style="display: none;">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const inputField = document.querySelector('#nombre-input-2');
    const errorMessage = document.getElementById('error-message');
    const emptyMessage = document.getElementById('empty-message');
    const fieldContainer = document.querySelector('.field-container');

    // Buscar opciones de grabado de frase por texto del label (robusto, case-insensitive)
    let conFraseOption = null;
    let sinFraseOption = null;

    document.querySelectorAll('input[type="radio"]').forEach(radio => {
      let label = document.querySelector(`label[for="${radio.id}"]`);
      if (!label) label = radio.closest('label');
      const textToCheck = (label ? label.textContent : radio.value).trim().toLowerCase();
      if (textToCheck.includes('con frase') || textToCheck.includes('con marcacion') || textToCheck.includes('con marcación')) {
        conFraseOption = radio;
      } else if (textToCheck.includes('sin frase') || textToCheck.includes('sin marcacion') || textToCheck.includes('sin marcación')) {
        sinFraseOption = radio;
      }
    });

    // Fallback a IDs conocidos
    if (!conFraseOption || !sinFraseOption) {
      console.warn('[12-words-foto] Fallback to IDs.');
      conFraseOption = conFraseOption || document.getElementById('template--16597763031109__main-1-1');
      sinFraseOption = sinFraseOption || document.getElementById('template--16597763031109__main-1-0');
    }

    console.log('[12-words-foto] Options found:', { conFraseOption, sinFraseOption });

    if (!conFraseOption || !sinFraseOption) {
      console.error('[12-words-foto] ERROR CRÍTICO: No se encontraron los radio buttons. Aprobando validación para no bloquear compra.');
      validador.DocePalabras = true;
      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      return;
    }

    function validarTexto() {
      if (!inputField) return;
      const words = inputField.value.trim().split(/\s+/).filter(w => w.length > 0);
      const wordCount = words.length;

      console.log(`[12-words-foto] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      if (wordCount === 0 || wordCount > 12) {
        validador.DocePalabras = false;
        if (errorMessage) errorMessage.style.display = wordCount > 12 ? 'block' : 'none';
        if (emptyMessage) emptyMessage.style.display = wordCount === 0 ? 'flex' : 'none';
        console.log(`[12-words-foto] FAIL. Words: ${wordCount}`);
      } else {
        validador.DocePalabras = true;
        if (errorMessage) errorMessage.style.display = 'none';
        if (emptyMessage) emptyMessage.style.display = 'none';
        console.log(`[12-words-foto] PASS. Words: ${wordCount}`);
      }

      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
    }

    function toggleCustomTextField() {
      if (conFraseOption.checked) {
        console.log('[12-words-foto] Opción CON frase seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'flex';
        validador.DocePalabras = false;
        validarTexto();
      } else if (sinFraseOption.checked) {
        console.log('[12-words-foto] Opción SIN frase seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'none';
        validador.DocePalabras = true;
        if (inputField) inputField.value = '';
        if (errorMessage) errorMessage.style.display = 'none';
        if (emptyMessage) emptyMessage.style.display = 'none';

        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    toggleCustomTextField();

    conFraseOption.addEventListener('change', toggleCustomTextField);
    sinFraseOption.addEventListener('change', toggleCustomTextField);

    if (inputField) inputField.addEventListener('input', validarTexto);
  });
</script>

<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: #961212;
    margin-right: 5px;
  }
</style>
