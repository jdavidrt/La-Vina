{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script>
  document.addEventListener("DOMContentLoaded", function() {
    console.log('[10-words-grabado] Inicializando validador.DiezPalabras = false');
    validador.DiezPalabras = false;
  })
</script>
<div class="field-container" style="display: none;">
  <div class="field">
    <input
      form="{{ product_form_id }}"
      id="input-10palabras"
      class="field__input"
      type="text"
      name="properties[Tu frase personalizada]"
    >
    <label class="field__label" for="input-10palabras">Escribe tu frase personalizada: (máximo 9 palabras)</label>
  </div>
  <p id="error-message" class="error-message">Solo se permiten hasta 9 palabras</p>
  <p id="empty-message" class="empty-message">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const inputField = document.querySelector("#input-10palabras");
    const errorMessage = document.getElementById("error-message");
    const emptyMessage = document.getElementById("empty-message");
    const fieldContainer = document.querySelector('.field-container');

    // Buscar opciones de "Grabado de frase" por el texto del label
    // Esto es más robusto que usar IDs hardcodeados
    let conFraseOption = null;
    let sinFraseOption = null;

    // Buscar todos los inputs de tipo radio en el formulario de producto
    const allRadios = document.querySelectorAll('input[type="radio"]');

    allRadios.forEach(radio => {
      // Intenta encontrar label por atributo 'for'
      let label = document.querySelector(`label[for="${radio.id}"]`);
      
      // Si no encuentra por 'for', busca si el input está DENTRO del label (común en algunos temas)
      if (!label) {
          label = radio.closest('label');
      }

      if (label) {
        const labelText = label.textContent.trim().toLowerCase();
        // Ajustamos la búsqueda para ser más flexibles
        if (labelText.includes('con frase') || radio.value.toLowerCase().includes('con frase') || radio.value.toLowerCase().includes('con marcación')) {
          conFraseOption = radio;
        } else if (labelText.includes('sin frase') || radio.value.toLowerCase().includes('sin frase') || radio.value.toLowerCase().includes('sin marcación')) {
          sinFraseOption = radio;
        }
      } else {
         // Fallback: comprobar valor del input directamente
         const val = radio.value.toLowerCase();
         if (val.includes('con frase') || val.includes('con marcación')) conFraseOption = radio;
         if (val.includes('sin frase') || val.includes('sin marcación')) sinFraseOption = radio;
      }
    });

    // Validar si encontró las opciones
    if (!conFraseOption || !sinFraseOption) {
      console.warn("[10-words-grabado] No se pudieron encontrar las opciones de 'Grabado de frase' automáticamente. Intentando selectores por valor explícito.");
      conFraseOption = document.querySelector('input[type="radio"][value*="Con Fraser"], input[type="radio"][value*="Con Marcación"]');
      sinFraseOption = document.querySelector('input[type="radio"][value*="Sin Frase"], input[type="radio"][value*="Sin Marcación"]');
    }

    if (!conFraseOption || !sinFraseOption) {
        console.error("[10-words-grabado] ERROR CRÍTICO: No se encontraron los radio buttons. La validación se deshabilitará para no bloquear la compra.");
        validador.DiezPalabras = true;
        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
        return;
    }

    console.log('[10-words-grabado] Opciones encontradas:', { conFraseOption, sinFraseOption });

    // Función para validar el campo de texto
    function validarTexto() {
      const valor = inputField.value;
      const words = valor.trim().split(/\s+/).filter(word => word.length > 0);
      const wordCount = words.length;

      console.log(`[10-words-grabado] Validando: "${valor}" | Palabras: ${wordCount}`);

      if (wordCount === 0 || wordCount > 9) {
        validador.DiezPalabras = false;
        errorMessage.style.display = wordCount > 9 ? "block" : "none";
        emptyMessage.style.display = wordCount === 0 ? "flex" : "none";
        console.log(`[10-words-grabado] Validación FALLIDA. WordCount: ${wordCount}. DiezPalabras = false`);
      } else {
        validador.DiezPalabras = true;
        errorMessage.style.display = "none";
        emptyMessage.style.display = "none";
        console.log(`[10-words-grabado] Validación EXITOSA. WordCount: ${wordCount}. DiezPalabras = true`);
      }

      // USAR SIEMPRE EL HELPER CENTRAL
      if (window.checkAndUpdateButton) {
          window.checkAndUpdateButton();
      }
    }

    // Función para mostrar/ocultar el campo de texto según la opción seleccionada
    function toggleCustomTextField() {
      if (conFraseOption.checked) {
        console.log('[10-words-grabado] Opción CON frase seleccionada');
        // "Con frase" seleccionado: mostrar campo y requerir validación
        fieldContainer.style.display = 'flex';
        validador.DiezPalabras = false;
        validarTexto();
      } else if (sinFraseOption.checked) {
        console.log('[10-words-grabado] Opción SIN frase seleccionada');
        // "Sin frase" seleccionado: ocultar campo y aprobar validación
        fieldContainer.style.display = 'none';
        validador.DiezPalabras = true;
        inputField.value = ''; // Limpiar el campo
        errorMessage.style.display = 'none';
        emptyMessage.style.display = 'none';
        
        if (window.checkAndUpdateButton) {
            window.checkAndUpdateButton();
        }
      }
    }

    // Inicializar según la opción seleccionada por defecto
    toggleCustomTextField();

    // Escuchar cambios en las opciones
    conFraseOption.addEventListener("change", toggleCustomTextField);
    sinFraseOption.addEventListener("change", toggleCustomTextField);

    // Validar texto cada vez que el usuario escribe
    inputField.addEventListener("input", validarTexto);
  });
</script>
<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
