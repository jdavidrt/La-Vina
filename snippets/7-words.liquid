{%- assign product_form_id = 'product-form-' | append: section.id -%}

<div class="field-container" style="display: none;">
  <div class="field">
    <input
      form="{{ product_form_id }}"
      id="input-7palabras"
      class="field__input"
      type="text"
      name="properties[Tu frase personalizada]"
    >
    <label class="field__label" for="input-7palabras">Escribe tu frase personalizada: (máximo 7 palabras)</label>
  </div>
  <p id="error-message-7" class="error-message" style="display: none;">Solo se permiten hasta 7 palabras</p>
  <p id="empty-message-7" class="empty-message" style="display: none;">
    Por favor ingresa la frase personalizada <span class="question-mark">!</span>
  </p>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    validador.SietePalabras = false;

    const inputField = document.getElementById("input-7palabras");
    const errorMessage = document.getElementById("error-message-7");
    const emptyMessage = document.getElementById("empty-message-7");
    const fieldContainer = document.querySelector('.field-container');

    // Buscar opciones de grabado de frase por texto del label (robusto, case-insensitive)
    let conFraseOption = null;
    let sinFraseOption = null;

    document.querySelectorAll('input[type="radio"]').forEach(radio => {
      // Buscar label por atributo 'for'
      let label = document.querySelector(`label[for="${radio.id}"]`);
      // Si no, buscar si el input está dentro del label
      if (!label) label = radio.closest('label');

      const textToCheck = (label ? label.textContent : radio.value).trim().toLowerCase();

      if (textToCheck.includes('con frase') || textToCheck.includes('con marcacion') || textToCheck.includes('con marcación')) {
        conFraseOption = radio;
      } else if (textToCheck.includes('sin frase') || textToCheck.includes('sin marcacion') || textToCheck.includes('sin marcación')) {
        sinFraseOption = radio;
      }
    });

    // Fallback a IDs conocidos si no se encontraron por label
    if (!conFraseOption || !sinFraseOption) {
      console.warn('[7-words] No encontrado por label. Intentando por IDs de fallback.');
      conFraseOption = conFraseOption || document.getElementById("template--16560373039173__main-2-1");
      sinFraseOption = sinFraseOption || document.getElementById("template--16560373039173__main-2-0");
    }

    console.log('[7-words] Options found:', { conFraseOption, sinFraseOption });

    if (!conFraseOption || !sinFraseOption) {
      console.error('[7-words] ERROR CRÍTICO: No se encontraron los radio buttons. Aprobando validación para no bloquear compra.');
      validador.SietePalabras = true;
      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      return;
    }

    function validarTexto() {
      if (!inputField) return;
      const words = inputField.value.trim().split(/\s+/).filter(w => w.length > 0);
      const wordCount = words.length;

      console.log(`[7-words] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      if (wordCount === 0 || wordCount > 7) {
        validador.SietePalabras = false;
        if (errorMessage) errorMessage.style.display = wordCount > 7 ? "block" : "none";
        if (emptyMessage) emptyMessage.style.display = wordCount === 0 ? "flex" : "none";
        console.log(`[7-words] FAIL. Words: ${wordCount}`);
      } else {
        validador.SietePalabras = true;
        if (errorMessage) errorMessage.style.display = "none";
        if (emptyMessage) emptyMessage.style.display = "none";
        console.log(`[7-words] PASS. Words: ${wordCount}`);
      }

      if (window.checkAndUpdateButton) window.checkAndUpdateButton();
    }

    function toggleCustomTextField() {
      if (conFraseOption.checked) {
        console.log('[7-words] Opción CON frase seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'flex';
        validador.SietePalabras = false;
        validarTexto();
      } else if (sinFraseOption.checked) {
        console.log('[7-words] Opción SIN frase seleccionada');
        if (fieldContainer) fieldContainer.style.display = 'none';
        validador.SietePalabras = true;
        if (inputField) inputField.value = '';
        if (errorMessage) errorMessage.style.display = 'none';
        if (emptyMessage) emptyMessage.style.display = 'none';

        if (window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    // Inicializar según la opción seleccionada por defecto
    toggleCustomTextField();

    // Escuchar cambios en las opciones
    conFraseOption.addEventListener("change", toggleCustomTextField);
    sinFraseOption.addEventListener("change", toggleCustomTextField);

    // Validar texto cuando el usuario escribe
    if (inputField) inputField.addEventListener("input", validarTexto);
  });
</script>

<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
