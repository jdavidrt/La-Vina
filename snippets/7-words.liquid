{%- assign product_form_id = 'product-form-' | append: section.id -%}
<script>
  document.addEventListener("DOMContentLoaded", function () {
    validador.SietePalabras = false;

    const inputField = document.getElementById("nombre-input-2");
    const errorMessage = document.getElementById("error-message");
    const emptyMessage = document.getElementById("empty-message");

    // Robust selector logic for radio buttons
    let conMarcacionOption = null;
    let sinMarcacionOption = null;

    const allRadios = document.querySelectorAll('input[type="radio"]');
    allRadios.forEach(radio => {
        const val = radio.value.toLowerCase();
        if (val.includes('con marcación') || val.includes('con marcacion')) conMarcacionOption = radio;
        if (val.includes('sin marcación') || val.includes('sin marcacion')) sinMarcacionOption = radio;
    });

    // Fallback to IDs if not found by value
    if (!conMarcacionOption || !sinMarcacionOption) {
      conMarcacionOption = conMarcacionOption || document.getElementById("template--16560373039173__main-2-1");
      sinMarcacionOption = sinMarcacionOption || document.getElementById("template--16560373039173__main-2-0");
    }

    console.log('[7-words] Options found:', {conMarcacionOption, sinMarcacionOption});

    // Función para mostrar/ocultar el campo de texto personalizado
    function toggleCustomTextField() {
      // Safety check
      if(!conMarcacionOption || !sinMarcacionOption) return;

      const container = document.querySelector('.field-container');

      if (conMarcacionOption.checked) {
        if(container) container.style.display = 'flex';
        validador.SietePalabras = false;
        validarTexto();
      }else if (sinMarcacionOption.checked) {
        if(container) container.style.display = 'none';
        validador.SietePalabras = true; 
        if(errorMessage) errorMessage.style.display = "none";
        
        if(window.checkAndUpdateButton) window.checkAndUpdateButton();
      }
    }

    // Inicializa el campo según la opción predeterminada
    toggleCustomTextField();

    // Escucha los cambios de selección en las opciones de marcación
    if(conMarcacionOption) conMarcacionOption.addEventListener("change", toggleCustomTextField);
    if(sinMarcacionOption) sinMarcacionOption.addEventListener("change", toggleCustomTextField);

    // Muestra el mensaje de "Por favor ingresa la frase personalizada" desde el inicio
    if(emptyMessage) emptyMessage.style.display = "flex";

    // Función para validar el campo de texto
    function validarTexto() {
      // Safety check
      if(!inputField) return;

      const words = inputField.value.trim().split(/\s+/).filter(word => word.length > 0);
      const wordCount = words.length;
      
      console.log(`[7-words] Validando: "${inputField.value}" | Palabras: ${wordCount}`);

      // Verifica si el campo está vacío o no cumple las condiciones
      if (wordCount === 0 || wordCount > 7 ) {
         validador.SietePalabras = false;
         if(errorMessage) errorMessage.style.display = wordCount > 0 ? "block" : "none";
         console.log(`[7-words] FAIL. Words: ${wordCount}`);
      } else {
        validador.SietePalabras = true;
        if(errorMessage) errorMessage.style.display = "none";
        console.log(`[7-words] PASS. Words: ${wordCount}`);
      }
      
      if(window.checkAndUpdateButton) window.checkAndUpdateButton();

      // Muestra el mensaje "Por favor ingresa la frase personalizada" si está vacío
      if(emptyMessage) emptyMessage.style.display = wordCount === 0 ? "flex" : "none";
    }

    // Escucha el evento input y valida el texto cada vez que cambia
    if(inputField) {
        inputField.addEventListener("input", function () {
          validarTexto();
        });
    }
  });
</script>
<style>
  .field-container {
    display: flex;
    flex-direction: column;
    gap: 5px;
    max-width: 300px;
  }

  .field__input {
    width: 100%;
    padding: 8px;
    font-size: 14px;
    border: 1px solid #ccc;
    border-radius: 4px;
    transition: border-color 0.3s;
  }

  .field__input:focus {
    border-color: #ff6600;
    outline: none;
  }

  .field {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .field__label {
    font-size: 14px;
    font-weight: bold;
    color: #333;
    margin-bottom: 5px;
  }

  .error-message, .empty-message {
    color: #961212;
    font-size: 12px;
  }

  .error-message {
    display: none;
  }

  .empty-message {
    display: flex;
    align-items: center;
  }

  .question-mark {
    font-weight: bold;
    color: red;
    margin-right: 5px;
  }
</style>
